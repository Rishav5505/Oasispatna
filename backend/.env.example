# Copy this file to .env and fill in real values. Never commit .env.

# ── Core ─────────────────────────────────────────────
PORT=5002
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
JWT_SECRET=change_me_to_a_long_random_string
FRONTEND_URL=http://localhost:5173

# ── Email (Brevo transactional API) ──────────────────
BREVO_API_KEY=xkeysib-your_brevo_api_key
SENDER_EMAIL=verified-sender@example.com
BREVO_TEMPLATE_ID=

# ── AI (Google Gemini) ───────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
# Optional: comma-separated fallback order
# GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest,gemini-2.5-flash

# ── Payments (Razorpay) — online payment is disabled until set ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── SMS / WhatsApp alerts (Twilio) — silently skipped until set ──
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=+1XXXXXXXXXX
TWILIO_WHATSAPP=false

# ── Web push notifications (generate once: npx web-push generate-vapid-keys) ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Invoices / certificates ──────────────────────────
INSTITUTE_NAME=Oasis JEE Classes
INSTITUTE_ADDRESS=Union Bank Building, Danapur, Patna - 801503
INSTITUTE_GSTIN=

# ── Daily jobs (fee reminders, overdue marking) ─────
# DISABLE_SCHEDULER=true

# ── QR + geofenced attendance ────────────────────────
INSTITUTE_LAT=25.6
INSTITUTE_LON=85.1
MAX_ATTENDANCE_DISTANCE=200

# ── Deployment ───────────────────────────────────────
# Number of reverse-proxy hops (auto-set to 1 on Render)
# TRUST_PROXY=1

# ── Local development only — NEVER set in production ──
# Prints OTPs in the server console when email sending fails
# OTP_CONSOLE_FALLBACK=true
